# ChannelHub environment — copy to .env (never commit .env) or set in Render dashboard
# Neon PostgreSQL connection string; sslmode=require is mandatory for Neon
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx-pooler.region.aws.neon.tech/channelhub?sslmode=require
SPRING_DATASOURCE_USERNAME=channelhub_owner
SPRING_DATASOURCE_PASSWORD=neon-password
# 64+ random hex chars; generate: openssl rand -hex 32
JWT_SECRET=change-me-64-random-hex-chars
# Real admin account password (admin@channelhub.in). Demo admin + demo reseller
# have fixed public creds by design (demo admin is read-only, server-enforced).
ADMIN_PASSWORD=change-me-strong
